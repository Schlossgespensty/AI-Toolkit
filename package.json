{
  "name": "ai-toolkit",
  "productName": "AI Toolkit",
  "version": "0.10.0",
  "description": "Stronghold Crusader AI Character, AIV castle, and UCP AI library editor",
  "author": "Schlossgespenst",
  "private": true,
  "main": "main.js",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "node-pkware": "^5.9.2"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check:syntax": "node scripts/check-syntax.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run check:syntax && npm test",
    "package": "npm run check && electron-builder --dir",
    "dist": "npm run check && electron-builder --win portable",
    "dist:zip": "npm run check && electron-builder --win zip"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "de.schlossgespenst.aitoolkit",
    "productName": "AI Toolkit",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*",
      "assets/**/*",
      "config/**/*"
    ],
    "extraFiles": [
      {
        "from": "config",
        "to": "config",
        "filter": [
          "**/*.json"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "AI-Toolkit-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "icon": "assets/icon.ico"
    }
  }
}
