{
  "name": "ai-toolkit",
  "productName": "AI Toolkit",
  "version": "0.11.0",
  "description": "Stronghold Crusader AI Character, AIV castle, and UCP AI library editor",
  "author": "Schlossgespenst",
  "private": true,
  "main": "main.js",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "i18next": "26.4.2",
    "js-yaml": "4.3.2",
    "node-pkware": "^5.9.2"
  },
  "scripts": {
    "start": "tauri dev",
    "dev": "tauri dev",
    "check:syntax": "node scripts/check-syntax.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run check:syntax && npm test",
    "package": "npm run check && node scripts/package-native.mjs",
    "dist": "npm run package",
    "dist:zip": "npm run package",
    "postinstall": "node scripts/prepare-renderer.js",
    "precheck": "node scripts/prepare-renderer.js",
    "test:game": "node --test tests/integration/*.test.js",
    "start:electron": "electron .",
    "dev:electron": "electron .",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:themes": "node scripts/build-themes.mjs",
    "build:locales": "node scripts/build-locales.js",
    "check:locales": "node scripts/build-locales.js --check --strict",
    "package:native": "node scripts/package-native.mjs",
    "package:electron": "npm run check && electron-builder --dir",
    "dist:electron": "npm run check && electron-builder --win portable"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@tauri-apps/cli": "2.11.5",
    "acorn": "8.18.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "fengari": "0.1.5",
    "fflate": "0.8.3",
    "pixi.js": "8.21.0",
    "style-dictionary": "5.5.5",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "de.schlossgespenst.aitoolkit",
    "productName": "AI Toolkit",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*",
      "assets/**/*",
      "config/**/*",
      "integrations/**/*",
      "!node_modules/js-yaml/dist/*.map"
    ],
    "extraFiles": [
      {
        "from": "config",
        "to": "config",
        "filter": [
          "**/*.json"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "AI-Toolkit-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "icon": "assets/icon.ico"
    },
    "electronLanguages": [
      "en-US",
      "de",
      "fr",
      "ru",
      "hu",
      "tr",
      "zh-CN",
      "es",
      "fa"
    ]
  }
}
